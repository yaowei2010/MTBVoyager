manifest {
    name = 'wgs-somatic-tumor-only'
    version = '0.3.3'
    nextflowVersion = '>=24.10.0'
}

params {
    input = null
    outdir = 'results'
    reference = null
    vep_cache = null
    vep_plugin_data = null
    vep_plugin_args = null
    vep_contigs = 'chr1,chr2,chr3,chr4,chr5,chr6,chr7,chr8,chr9,chr10,chr11,chr12,chr13,chr14,chr15,chr16,chr17,chr18,chr19,chr20,chr21,chr22,chrX,chrY,chrM'
    vep_max_parallel = 5
    vep_fork_per_shard = 6
    buffer_size = 5000
    pass_only = true
    dp_min = 20
    alt_reads_min = 5
    vaf_min = 0.05
    population_af_max = 0.01
    cancer_db = null
    annotsv_annotations = null
    oncovi_resources = null
    cancer_type = ''
    skip_vep = false
}

process {
    executor = 'local'
    errorStrategy = 'terminate'
    shell = ['/bin/bash', '-euo', 'pipefail']
    withLabel: bcftools { container = 'quay.io/biocontainers/bcftools:1.20--h8b25389_0'; cpus = 2; memory = '8 GB' }
    withName: VEP_ANNOTATE_SHARD {
        container = 'ensemblorg/ensembl-vep:release_112.0'
        cpus = { params.vep_fork_per_shard as int }
        memory = '22 GB'
        maxForks = params.vep_max_parallel as int
        time = '48h'
    }
    withName: SPLIT_VCF_BY_CONTIG { container = 'quay.io/biocontainers/bcftools:1.20--h8b25389_0'; cpus = 1; memory = '2 GB'; maxForks = 4 }
    withLabel: python { container = 'ncku-wgs-python:20260721'; cpus = 1; memory = '4 GB' }
}

docker { enabled = true; runOptions = '-u $(id -u):$(id -g)' }
timeline.enabled = true
report.enabled = true
trace.enabled = true
dag.enabled = true

profiles {
    test {
        params.input = "${projectDir}/tests/data/samplesheet.csv"
        params.reference = "${projectDir}/tests/data/GRCh38.test.fa"
        params.skip_vep = true
        params.oncovi_resources = "${projectDir}/tests/data/oncovi_resources"
    }
    docker { docker.enabled = true }
}

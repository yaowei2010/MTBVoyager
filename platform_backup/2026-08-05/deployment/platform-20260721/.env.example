DATA_ROOT=/absolute/path/to/ncku_hospital
WGS_REFERENCE_ROOT=/absolute/path/to/WGS/reference
WGS_VEP_MAX_PARALLEL=8
WGS_VEP_FORK_PER_SHARD=3
LITERATURE_LLM_MODEL=Qwen2.5-1.5B-Instruct-Q4_K_M
LITERATURE_LLM_MODEL_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf
LITERATURE_LLM_THREADS=16
LITERATURE_MODEL_ROOT=/absolute/path/to/literature_models
NCBI_EMAIL=your-email@example.org
WGS_VEP_PLUGIN_ARGS=dbNSFP,Plugins/dbNSFP5.3.1a_grch38.gz,REVEL_score,CADD_phred,ClinPred_score;AlphaMissense,file=Plugins/AlphaMissense_hg38.tsv.gz;PrimateAI,Plugins/PrimateAI_scores_v0.2_GRCh38_sorted.tsv.bgz;SpliceAI,snv=Plugins/spliceai_scores.raw.snv.hg38.vcf.gz,indel=Plugins/spliceai_scores.raw.indel.hg38.vcf.gz,cutoff=0.5,split_output=1
POSTGRES_DB=somatic
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me_to_a_long_random_password
FRONTEND_PORT=3002

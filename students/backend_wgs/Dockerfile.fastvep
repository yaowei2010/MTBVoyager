# Inherit the deployed legacy/frontend API behavior; update only the WGS modules.
FROM takeshi945/nckumtb:backend-wgs-germline-20260722-acmg-sf-v33
LABEL org.opencontainers.image.title="MTB backend WGS fastVEP branch" \
      org.opencontainers.image.version="20261001-fastvep"
COPY wgs_germline /miRTI/wgs_germline
COPY --from=wgs_somatic wgs_somatic /miRTI/wgs_somatic
COPY pipeline /opt/wgs-germline-pipeline
COPY --from=wgs_somatic pipeline /opt/wgs-somatic-pipeline
ENV WGS_ANNOTATION_ENGINE=fastvep \
    WGS_PIPELINE_SOURCE=/opt/wgs-germline-pipeline \
    WGS_SOMATIC_PIPELINE_SOURCE=/opt/wgs-somatic-pipeline
